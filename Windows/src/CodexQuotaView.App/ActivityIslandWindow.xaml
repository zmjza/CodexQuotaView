<Window
    x:Class="CodexQuotaView.App.ActivityIslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CodexQuotaView Activity">
    <Grid Width="274" Height="64" Background="#D9000000">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="Orb" Width="28" Height="28" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="StateText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock x:Name="DetailText" Text="—" FontSize="10" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</Window>
