<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CodexQuotaView.App</RootNamespace>
    <AssemblyName>CodexQuotaView</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishProfile>Default</PublishProfile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexQuotaView.Core\CodexQuotaView.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\CodexQuotaView.Rendering.Native\x64\$(Configuration)\CodexQuotaViewRendering.dll"
             Link="CodexQuotaViewRendering.dll"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\CodexQuotaView.Rendering.Native\x64\$(Configuration)\CodexQuotaViewRendering.dll')" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>
  <Target Name="BuildNativeRendering" BeforeTargets="Build">
    <MSBuild Projects="..\CodexQuotaView.Rendering.Native\CodexQuotaView.Rendering.Native.vcxproj"
             Properties="Configuration=$(Configuration);Platform=x64"
             Targets="Build" />
    <Copy SourceFiles="..\CodexQuotaView.Rendering.Native\x64\$(Configuration)\CodexQuotaViewRendering.dll"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('..\CodexQuotaView.Rendering.Native\x64\$(Configuration)\CodexQuotaViewRendering.dll')" />
  </Target>
</Project>
