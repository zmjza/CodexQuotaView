<Window
    x:Class="CodexQuotaView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodexQuotaView.App"
    Title="CodexQuotaView">
    <Grid Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="OverviewRoot" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <controls:QuotaOverviewControl x:Name="Overview"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="12,8,12,8">
            <TextBlock Text="样例数据" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ComboBox x:Name="FixturePicker" SelectionChanged="OnFixtureChanged" MinWidth="120">
                <ComboBoxItem Content="可用" Tag="available"/>
                <ComboBoxItem Content="警告" Tag="warning"/>
                <ComboBoxItem Content="耗尽" Tag="exhausted"/>
                <ComboBoxItem Content="不可用" Tag="unavailable"/>
                <ComboBoxItem Content="错误" Tag="error"/>
            </ComboBox>
            </StackPanel>
        </Grid>
        <controls:SettingsControl x:Name="Settings" Grid.Row="0" Visibility="Collapsed"/>
        <controls:ResetControl x:Name="ResetPage" Grid.Row="0" Visibility="Collapsed"/>
        <Button x:Name="OpenSettingsButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Width="28" Height="28" Padding="0" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
        <Button x:Name="OpenResetButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,48" Width="28" Height="28" Padding="0" Content="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Click="OnOpenReset"/>
        <Button x:Name="OpenWidgetButton" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Width="28" Height="28" Padding="0" Content="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="12" Click="OnOpenWidget"/>
    </Grid>
</Window>
