<Window
    x:Class="CodexQuotaView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CodexQuotaView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <NavigationView x:Name="Nav" Grid.Row="0" PaneDisplayMode="Top" IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview"/>
                <NavigationViewItem Content="Activity" Tag="activity"/>
            </NavigationView.MenuItems>
        </NavigationView>
        <StackPanel Grid.Row="1" Padding="16,12,16,16" Spacing="8">
            <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" Text="CodexQuotaView"/>
            <TextBlock x:Name="StateText" Text="Initializing"/>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClicked"/>
        </StackPanel>
    </Grid>
</Window>
