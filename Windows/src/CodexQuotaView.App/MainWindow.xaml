<Window
    x:Class="CodexQuotaView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodexQuotaView.App"
    Title="CodexQuotaView">
    <Grid Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:QuotaOverviewControl x:Name="Overview" Grid.Row="0"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="12,8,12,8">
            <TextBlock Text="样例数据" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ComboBox x:Name="FixturePicker" SelectionChanged="OnFixtureChanged" MinWidth="120">
                <ComboBoxItem Content="可用" Tag="available"/>
                <ComboBoxItem Content="警告" Tag="warning"/>
                <ComboBoxItem Content="耗尽" Tag="exhausted"/>
                <ComboBoxItem Content="不可用" Tag="unavailable"/>
                <ComboBoxItem Content="错误" Tag="error"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</Window>
