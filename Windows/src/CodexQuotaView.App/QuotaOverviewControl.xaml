<UserControl
    x:Class="CodexQuotaView.App.QuotaOverviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="274" Height="433">
    <Grid Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                <TextBlock Text="C" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="CodexQuotaView" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Width="24" Height="24" Padding="0" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
        </Grid>
        <Grid Grid.Row="1" Padding="12,0,12,0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="2">
                <Grid>
                    <TextBlock x:Name="PlanText" Text="—" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="StatusText" Text="—" FontSize="10" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="RemainingText" Text="—" FontSize="21" FontWeight="SemiBold"/>
                <ProgressBar x:Name="QuotaBar" Height="8" Maximum="100" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="ResetText" Text="—" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Grid Grid.Row="1" Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="已用" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="UsedText" Grid.Column="0" Text="—" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="1" Text="剩余" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,0,0"/>
                <TextBlock x:Name="RemainingPercentText" Grid.Column="1" Text="—" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="12,0,0,0"/>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="4,2,4,2">
                    <TextBlock Text="Spark" FontSize="9" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="SparkText" Text="—" FontSize="10.5" VerticalAlignment="Center"/>
                <TextBlock x:Name="SparkResetText" Text="—" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Credits" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="CreditsText" Text="—" FontSize="10.5" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="30 日 Token" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="Tokens30dText" Text="—" FontSize="10.5" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="成本估算" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="CostText" Text="—" FontSize="10.5" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
            <ItemsControl Grid.Row="4" x:Name="ActivityGrid"/>
        </Grid>
        <Grid Grid.Row="2" Padding="12,0,12,0">
            <TextBlock x:Name="UpdatedText" Text="—" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
