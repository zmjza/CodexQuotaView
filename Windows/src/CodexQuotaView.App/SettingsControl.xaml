<UserControl
    x:Class="CodexQuotaView.App.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="560">
    <ScrollViewer>
        <StackPanel Padding="24,20,24,24" Spacing="16">
            <Border x:Name="ModeBadge" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}" Padding="6,3,6,3" HorizontalAlignment="Left">
                <TextBlock x:Name="ModeBadgeText" Text="SETTINGS" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
            </Border>
            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="CodexQuotaView 1.0.0 (1)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="主题" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="ThemePicker" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="跟随系统" Tag="system"/>
                    <ComboBoxItem Content="浅色" Tag="light"/>
                    <ComboBoxItem Content="深色" Tag="dark"/>
                </ComboBox>
                <TextBlock Grid.Row="1" Text="语言" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LanguagePicker" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="跟随系统" Tag="system"/>
                    <ComboBoxItem Content="简体中文" Tag="zh-Hans"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
            </Grid>

            <TextBlock Text="行为" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ToggleSwitch x:Name="AutoRefreshToggle" Header="自动刷新" OnContent="开" OffContent="关"/>
            <ToggleSwitch x:Name="ActivityIslandToggle" Header="Codex 活动状态" OnContent="开" OffContent="关"/>
            <ToggleSwitch x:Name="ResetEntryToggle" Header="显示额度重置入口" OnContent="开" OffContent="关"/>

            <TextBlock Text="材质" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ComboBox x:Name="GlassModePicker">
                <ComboBoxItem Content="磨砂玻璃" Tag="frosted"/>
                <ComboBoxItem Content="清透玻璃" Tag="clear"/>
            </ComboBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
